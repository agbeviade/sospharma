{
  "expo": {
    "name": "SOS Pharma",
    "slug": "sos-pharma",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sospharma",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C5A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.sospharma.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SOS Pharma utilise votre position pour trouver les pharmacies de garde les plus proches."
      }
    },
    "android": {
      "package": "ci.sospharma.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C5A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SOS Pharma utilise votre position pour trouver les pharmacies de garde."
        }
      ]
    ]
  }
}
